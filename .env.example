# Server secrets
ALERTS_SECRET="changeme-alerts-secret"
CRON_SECRET="changeme-cron-secret"
INTERNAL_RENDER_SECRET=""
INTERNAL_RENDER_URL=""
FACEBOOK_APP_SECRET="changeme-fb-secret"
TOKEN_VAULT_KEY="generate-with-openssl-rand-hex-32"
TOKEN_VAULT_KEY_VERSION="1"
INSTAGRAM_APP_ID="changeme-instagram-app-id"
INSTAGRAM_APP_SECRET="changeme-instagram-app-secret"
INSTAGRAM_VERIFY_TOKEN="changeme-instagram-verify-token"
OPENAI_API_KEY="sk-your-openai-key"
RESEND_API_KEY="re_your-resend-key"
RESEND_FROM="CheersAI <noreply@auth.orangejelly.co.uk>"
# Operator alerts (repeated publish failures for a brand). Required in production.
OPERATOR_ALERT_EMAIL="peter@orangejelly.co.uk"
SUPABASE_SERVICE_ROLE_KEY="changeme-supabase-service-role"
VERCEL_OIDC_TOKEN=""
ENABLE_CONNECTION_DIAGNOSTICS="false"
# Feature flag: apply per-ad-set CBO spend caps when publishing food campaigns (true/1 to enable; default off)
FOOD_OPTIMISATION_ENABLED="false"
# Feature flag: weekly auto-materialisation cron extends rolling food campaigns by one week (true/1 to enable; default off — cron is a no-op when off)
FOOD_AUTO_MATERIALISE_ENABLED="false"
BOOKING_CONVERSION_INGEST_SECRET="changeme-booking-conversion-secret"
BOOKING_CONVERSION_ACCOUNT_ID="00000000-0000-0000-0000-000000000000"
# Stripe billing (Orange Jelly Limited account, shared with the management app).
# Optional at build time: without them billing shows "Billing is not set up yet"
# and /api/stripe/webhook returns 503. The ids below are TEST mode objects; live
# mode has its own key, webhook secret, price ids and portal configuration.
STRIPE_SECRET_KEY="sk_test_changeme"
STRIPE_WEBHOOK_SECRET="whsec_changeme"
STRIPE_PRICE_STARTER_MONTHLY="price_1UJs0CIMsxxxvzCCbeBtgOie"
STRIPE_PRICE_STARTER_ANNUAL="price_1UJs0DIMsxxxvzCCHBoaWxfh"
STRIPE_PRICE_PROFESSIONAL_MONTHLY="price_1UJs0DIMsxxxvzCCTpXkzq5a"
STRIPE_PRICE_PROFESSIONAL_ANNUAL="price_1UJs0EIMsxxxvzCCcjrOKfZZ"
STRIPE_PORTAL_CONFIGURATION_ID="bpc_1UJs0QIMsxxxvzCCRkUnIFH8"

# Client/public envs
NEXT_PUBLIC_FACEBOOK_APP_ID="changeme-facebook-app-id"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="changeme-supabase-anon"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Feature flag: enable the food_booking paid campaign type (true/1 to enable; ships dark by default)
NEXT_PUBLIC_ENABLE_FOOD_BOOKING="false"
