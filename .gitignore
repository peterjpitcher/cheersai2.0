# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase generated artifacts
supabase/.temp/
supabase/.branches/
supabase/remote-*-backup.sql
# staged v1 baseline (scripts/build-v1-baseline.py) — staged by CI and db:rebuild only,
# must never be committed or pushed to prod
supabase/migrations/20260519230001_v1_baseline.sql
/temp/
.worktrees/
.claude/worktrees/
.claire/
.claude/session-context.md
.claude/changes-manifest.log
.claude/docs/

# generated agent investigation artifacts
tasks/banner-*.md
tasks/codex-qa-review/*-review-pack.md
tasks/codex-qa-review/*-findings.json
.env*.local
node-compile-cache/

# graphify knowledge-graph output (generated tooling artifact)
graphify-out/

# ======== Workspace ignore baseline (added 6 November 2026) ========

# ---- Local private data: never committed ----
# Traffic figures, Search Console or Keyword Planner exports, client numbers
# and contact lists live in private/ (or a raw/ folder beside a task). Reports in git cite numbers by summary only.
private/
**/raw/

# ---- Environment and secrets (templates stay tracked) ----
!.env.example
!.env.*.example
*.key
*.p12
*.pfx

# ---- Build output ----
dist/
.turbo/

# ---- Tests ----
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-mcp/
.eslintcache

# ---- Logs and editor or OS noise ----
*.log
*.swp
*.swo
*.bak
Thumbs.db
.idea/

# ---- Claude Code and agent tooling ----
.superpowers/
tasks/claude-audit-backups/
tasks/codex-qa-review/*.log
